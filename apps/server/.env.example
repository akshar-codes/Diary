PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://127.0.0.1:27017/personal_diary_notes
JWT_ACCESS_SECRET=diary_notes_jwt_access_secret_token_key_change_in_production
JWT_REFRESH_SECRET=diary_notes_jwt_refresh_secret_token_key_change_in_production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
CORS_ORIGINS=http://localhost:5173,https://your-app.vercel.app
UPLOAD_DIR=./uploads
TRASH_RETENTION_DAYS=30

# Cloudinary (optional in development, recommended for persistent storage on Render)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Android Release Metadata
ANDROID_VERSION_NAME=1.0.0
ANDROID_VERSION_CODE=1
ANDROID_MIN_VERSION_CODE=1
ANDROID_APK_URL=
ANDROID_RELEASE_NOTES=Initial release
ANDROID_RELEASE_DATE=2026-11-14T00:00:00.000Z
ANDROID_UPDATE_MANDATORY=false

# Web Release Metadata
WEB_VERSION=1.0.0
WEB_RELEASE_NOTES=
WEB_RELEASE_DATE=2026-11-14T00:00:00.000Z
