PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://127.0.0.1:27017/personal_diary_notes
JWT_ACCESS_SECRET=diary_notes_jwt_access_secret_token_key_change_in_production
JWT_REFRESH_SECRET=diary_notes_jwt_refresh_secret_token_key_change_in_production
