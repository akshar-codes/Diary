# Render environment reference. Set these values in the service environment;
# Render provides PORT. For local development, put local values in .env.local.
NODE_ENV=production
MONGO_URI=mongodb+srv://<username>:<password>@<cluster-host>/<database>?retryWrites=true&w=majority
JWT_ACCESS_SECRET=replace_with_a_random_secret_at_least_32_characters
JWT_REFRESH_SECRET=replace_with_a_different_random_secret_at_least_32_characters
CORS_ORIGINS=https://your-frontend.vercel.app

JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
TRASH_RETENTION_DAYS=30

CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

ANDROID_VERSION_NAME=1.0.0
ANDROID_VERSION_CODE=1
ANDROID_MIN_VERSION_CODE=1
ANDROID_GITHUB_RELEASE_API=https://api.github.com/repos/akshar-codes/Diary/releases/latest
# Optional fallback used only when GitHub Releases cannot be reached.
ANDROID_APK_URL=
ANDROID_RELEASE_NOTES=Initial release
ANDROID_UPDATE_MANDATORY=false
ANDROID_RELEASE_DATE=2026-11-18T00:00:00.000Z

WEB_VERSION=1.0.0
WEB_RELEASE_NOTES=
WEB_RELEASE_DATE=2026-11-18T00:00:00.000Z

# OAuth Configuration
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/api/v1/auth/google/callback

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:5000/api/v1/auth/github/callback

# Brevo (Sendinblue) Transactional Email Service
BREVO_API_KEY=
EMAIL_SENDER_NAME="Journal & Notes"
EMAIL_SENDER_ADDRESS="noreply@yourdomain.com"

# Web Client URL
FRONTEND_URL=http://localhost:5173
