# Copy to apps/web/.env.local for local development. Vite prefers .env.local to .env.
# Set the same values in Vercel Project Settings > Environment Variables.
# Include the backend API prefix; do not add a trailing slash.
VITE_API_URL=https://your-api.onrender.com/api/v1

# Optional. Falls back to the version returned by the backend when omitted.
VITE_APP_VERSION=1.0.0
